<resources>

    <style name="AppBaseTheme" parent="android:Theme.Material">
        <item name="android:windowBackground">@color/bridge_bg</item>
        <item name="android:colorBackground">@color/bridge_bg</item>
        <item name="android:colorAccent">@color/bridge_accent</item>
        <item name="android:textColorPrimary">@color/bridge_text_primary</item>
        <item name="android:textColorSecondary">@color/bridge_text_secondary</item>
        <item name="android:statusBarColor">@color/bridge_bg</item>
        <item name="android:navigationBarColor">@color/bridge_bg</item>
        <item name="android:alertDialogTheme">@style/BridgeAlertDialogTheme</item>
    </style>

    <style name="BridgeAlertDialogTheme" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorBackground">@color/bridge_surface</item>
        <item name="android:colorAccent">@color/bridge_accent</item>
        <item name="android:textColorPrimary">@color/bridge_text_primary</item>
        <item name="android:textColorSecondary">@color/bridge_text_secondary</item>
    </style>

</resources>
