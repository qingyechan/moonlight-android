<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/appViewRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bridge_bg"
    tools:context=".AppView">

    <ImageView
        android:id="@+id/customBgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/customBgScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A60B111A"
        android:visibility="gone" />

    <RelativeLayout
        android:id="@+id/appHeaderContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/bridge_surface"
        android:paddingLeft="20dp"
        android:paddingTop="14dp"
        android:paddingRight="20dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/appListText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:ellipsize="end"
            android:gravity="center"
            android:paddingLeft="52dp"
            android:paddingRight="52dp"
            android:preferKeepClear="true"
            android:singleLine="true"
            android:textColor="@color/bridge_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/addShortcutButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_icon_pill"
            android:contentDescription="@string/shortcut_add_title"
            android:padding="9dp"
            android:preferKeepClear="true"
            android:scaleType="centerInside"
            android:src="@drawable/ic_add" />
    </RelativeLayout>

    <View
        android:id="@+id/appHeaderDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/appHeaderContainer"
        android:background="@color/bridge_border" />

    <FrameLayout
        android:id="@+id/appFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/appHeaderDivider"
        android:layout_alignParentBottom="true"
        android:gravity="center" />

</RelativeLayout>
