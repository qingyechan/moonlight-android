<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pcViewRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bridge_bg"
    tools:context=".PcView">

    <ImageView
        android:id="@+id/customBgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/customBgScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A60B111A"
        android:visibility="gone" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="18dp"
        android:paddingTop="16dp"
        android:paddingRight="18dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:id="@+id/sideRail"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentBottom="true"
            android:background="@drawable/bg_rail_panel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_icon_pill"
                android:contentDescription="@string/title_settings"
                android:nextFocusForward="@id/bgSettingsButton"
                android:padding="11dp"
                android:preferKeepClear="true"
                android:scaleType="centerInside"
                android:src="@drawable/ic_settings" />

            <ImageButton
                android:id="@+id/bgSettingsButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_icon_pill"
                android:contentDescription="@string/title_custom_background"
                android:nextFocusForward="@id/renameDevicesButton"
                android:padding="11dp"
                android:preferKeepClear="true"
                android:scaleType="centerInside"
                android:src="@drawable/ic_wallpaper" />

            <ImageButton
                android:id="@+id/renameDevicesButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_icon_pill"
                android:contentDescription="@string/title_rename_devices"
                android:nextFocusForward="@id/manuallyAddPc"
                android:padding="11dp"
                android:preferKeepClear="true"
                android:scaleType="centerInside"
                android:src="@drawable/ic_edit_name" />

            <ImageButton
                android:id="@+id/manuallyAddPc"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_icon_pill"
                android:contentDescription="@string/title_add_pc"
                android:nextFocusForward="@id/checkUpdateButton"
                android:padding="11dp"
                android:preferKeepClear="true"
                android:scaleType="centerInside"
                android:src="@drawable/ic_add" />

            <ImageButton
                android:id="@+id/checkUpdateButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_icon_pill"
                android:contentDescription="@string/title_check_update"
                android:padding="11dp"
                android:preferKeepClear="true"
                android:scaleType="centerInside"
                android:src="@drawable/ic_update" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginStart="18dp"
            android:layout_marginLeft="18dp"
            android:layout_toEndOf="@id/sideRail"
            android:layout_toRightOf="@id/sideRail"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pcview_title"
                    android:textColor="@color/bridge_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pcTitleSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/pcview_subtitle"
                    android:textColor="@color/bridge_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/keyboardBridgePill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_pill_warn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="14dp"
                android:paddingTop="8dp"
                android:paddingRight="14dp"
                android:paddingBottom="8dp">

                <View
                    android:id="@+id/keyboardBridgeDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/dot_warn" />

                <TextView
                    android:id="@+id/keyboardBridgeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/keyboard_bridge_pill_off"
                    android:textColor="@color/bridge_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/pcFragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/headerBar"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="18dp"
            android:layout_marginLeft="18dp"
            android:layout_toEndOf="@id/sideRail"
            android:layout_toRightOf="@id/sideRail"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/no_pc_found_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:background="@drawable/bg_rail_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="28dp"
                android:paddingTop="20dp"
                android:paddingRight="28dp"
                android:paddingBottom="20dp">

                <ProgressBar
                    android:id="@+id/pcs_loading"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:indeterminate="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginLeft="16dp"
                    android:text="@string/searching_pc"
                    android:textColor="@color/bridge_text_primary"
                    android:textSize="16sp" />
            </LinearLayout>

        </RelativeLayout>

    </RelativeLayout>

</RelativeLayout>
